% neurips_placeholder.sty — TEMPORARY stand-in for the official NeurIPS 2027 style file (not yet released).
% It only approximates the official page geometry (5.5 in x 9 in text block, Times, 10 pt) so that page budgets are
% realistic. Replace with the official neurips_2027.sty as soon as the call for papers is published (G9_PLAN O5).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_placeholder}[2026/11/03 placeholder for NeurIPS 2027 style]
\RequirePackage[letterpaper,textwidth=5.5in,textheight=9in,top=1in,headheight=12pt,headsep=25pt,footskip=30pt]{geometry}
\RequirePackage{times}
\RequirePackage[T1]{fontenc}
\RequirePackage{lineno}
\linenumbers
\renewcommand\linenumberfont{\normalfont\tiny\sffamily\color{gray}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt}
\renewcommand{\maketitle}{%
  \begin{center}
    {\rule{\textwidth}{4pt}\par\vspace{0.25in}}
    {\LARGE\bfseries\@title\par}
    {\vspace{0.2in}\rule{\textwidth}{1pt}\par\vspace{0.25in}}
    {Anonymous Author(s)\\Affiliation\\Address\\\texttt{email}\par}
    \vspace{0.3in}
  \end{center}}
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}\vspace{0.5ex}\begin{quote}}{\par\end{quote}\vskip 1ex}
